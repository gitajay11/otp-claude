# ─────────────────────────────────────────────────────────────
#  Nexus OTP Auth — server configuration
#  Copy to server/.env and fill in your values.
# ─────────────────────────────────────────────────────────────

# development | production  (production enables Secure cookies and requires JWT_SECRET)
NODE_ENV=development
PORT=4000
APP_NAME=Nexus

# Long random string (≥ 32 chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Postgres connection string (Neon recommended — use the *pooled* URL).
# Create the tables once with:  npm run db:migrate
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Set when running behind a reverse proxy so rate limits see real client IPs
# (e.g. 1 for a single proxy hop). Leave empty locally; defaults to 1 on Vercel.
TRUST_PROXY=

# ── SMTP (Nodemailer) ────────────────────────────────────────
# Examples:
#   Gmail:     smtp.gmail.com, port 465 (or 587), SMTP_USER=you@gmail.com,
#              SMTP_PASS=<16-char App Password, requires 2-Step Verification>
#   Outlook:   smtp.office365.com, port 587
#   Mailtrap:  sandbox.smtp.mailtrap.io, port 2525 (great for testing)
#   Brevo:     smtp-relay.brevo.com, port 587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# Optional override; defaults to true on port 465, false otherwise (STARTTLS)
# SMTP_SECURE=true
SMTP_USER=you@example.com
SMTP_PASS=your-app-password
MAIL_FROM="Nexus Security <you@example.com>"
